#!/usr/bin/env bash
# A gum stub for the front-end tests: scripted answers instead of a terminal.
#
# Answers come from $GUM_ANSWERS, one per line, popped in order by a counter in
# $GUM_STATE. `choose` and `filter` print the next answer; `input` and `write`
# read it as what the field holds when Enter is pressed; `confirm` reads it as
# yes/no/enter/esc. Everything that only draws is echoed to stderr, so a
# transcript shows what the user would have seen.
#
# Exit codes are gum's (Kamino item 196): 130 for Esc/Ctrl-C (and for a prompt
# the answers file has run out for), 80 for a command gum does not have. A gum
# command this stub does not model fails loudly instead of printing nothing
# and exiting 0, which a front-end would read as an empty answer.
set -uo pipefail

_pop() {
    local i line
    i="$(cat "$GUM_STATE" 2>/dev/null || echo 0)"
    line="$(sed -n "$((i + 1))p" "$GUM_ANSWERS" 2>/dev/null)"
    echo $((i + 1)) > "$GUM_STATE"
    printf '%s' "$line"
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
    choose|filter)
        # filter is choose with a search box: the same list, the same answer
        # (what Enter picks), the same refusal of anything not offered.
        #
        # Faithful to gum in the two ways a front-end can get wrong (Kamino
        # item 143). The options are the list arguments - or, given none,
        # stdin's lines, which is where `printf ... | gum choose` puts them;
        # real gum reads stdin only then, so stdin is left alone otherwise
        # (a blind drain would take the harness's own stdin and hang). And an
        # answer that was not offered is refused: this used to return the
        # scripted answer whether or not the menu held it, so a picker
        # listing the wrong things passed every test.
        #
        # The offered items and the header are echoed, because real gum puts
        # them on the screen and a test about which items a menu offers has
        # nothing to assert on otherwise.
        opts=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --header|--selected|--limit|--height|--placeholder|--value|--prompt|--width|--indicator|--cursor|--timeout)
                    [[ "$1" == --header ]] && printf '<header> %s\n' "${2:-}" >&2
                    shift 2 || shift ;;
                --*) shift ;;
                *)   opts+=("$1"); shift ;;
            esac
        done
        (( ${#opts[@]} )) || mapfile -t opts
        for o in "${opts[@]}"; do printf '<option> %s\n' "$o" >&2; done
        a="$(_pop)"
        # "esc", or no scripted answer left, is the user pressing Esc: gum
        # exits 130 then, as for confirm.
        if [[ -z "$a" || "$a" == esc ]]; then printf '<%s> (esc)\n' "$cmd" >&2; exit 130; fi
        printf '<%s> %s\n' "$cmd" "$a" >&2
        # A multi-select (--no-limit) answer is several lines; the answers
        # file has one per prompt, so a literal \n inside one splits it.
        mapfile -t picked <<< "${a//\\n/$'\n'}"
        for p in "${picked[@]}"; do
            ok=0
            for o in "${opts[@]}"; do [[ "$p" == "$o" ]] && { ok=1; break; }; done
            if (( ! ok )); then
                printf '<stub-error> %s: "%s" was not offered\n' "$cmd" "$p" >&2
                # Also to a log run-all.sh reads: a front-end reads gum's
                # failure as a cancel and carries on, so a refusal on stderr
                # alone can sit inside a passing test.
                [[ -n "${GUM_STUB_ERRLOG:-}" ]] && printf '%s: "%s" was not offered (offered: %s)\n' "$cmd" "$p" "${opts[*]}" >> "$GUM_STUB_ERRLOG"
                exit 1
            fi
        done
        printf '%s\n' "${a//\\n/$'\n'}" ;;
    confirm)
        # "enter" is the user pressing Enter on the highlighted button: gum's
        # default, which is yes unless --default=false says otherwise (Kamino
        # item 178). Without it the stub could not see a default at all, and a
        # destructive prompt that flipped to default-yes passed every test.
        dflt=yes
        for f in "$@"; do
            case "$f" in
                --default|--default=true) dflt=yes ;;
                --default=false)          dflt=no ;;
            esac
        done
        a="$(_pop)"; printf '<confirm> %s -> %s\n' "$*" "$a" >&2
        [[ "$a" == enter ]] && { a="$dflt"; printf '<confirm> (enter: the default, %s)\n' "$a" >&2; }
        case "$a" in
            yes) exit 0 ;;
            esc) exit 130 ;;   # what gum returns on Esc/Ctrl-C, which _ask reads as "cancelled"
            *)   exit 1 ;;
        esac ;;
    input|write)
        # Faithful to gum's --value (Kamino item 196): the field opens holding
        # it, so pressing Enter returns it. A blank answer is that Enter - the
        # user typed nothing - and returns the pre-filled value, not "": the
        # stub used to drop --value, so a prompt that saves whatever comes
        # back looked as if Enter kept the setting while real gum saved the
        # pre-filled value. "<clear>" is the user deleting it and pressing
        # Enter (empty); any other answer is what the user left in the field.
        # "esc", or no answer left, is Esc: exit 130, nothing printed.
        # A literal \n in an answer is a line break (write is multi-line).
        val="" flags=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --value)   val="${2:-}"; shift 2 || shift ;;
                --value=*) val="${1#--value=}"; shift ;;
                --header|--placeholder|--prompt|--width|--height|--char-limit|--cursor.mode|--timeout)
                    [[ "$1" == --header ]] && flags+=("header: ${2:-}")
                    shift 2 || shift ;;
                --password) flags+=(password); shift ;;
                *) shift ;;
            esac
        done
        i="$(cat "$GUM_STATE" 2>/dev/null || echo 0)"
        if (( i >= $(wc -l < "$GUM_ANSWERS" 2>/dev/null || echo 0) )); then a=esc; else a="$(_pop)"; fi
        [[ "$a" == esc ]] && { echo $((i + 1)) > "$GUM_STATE"; printf '<%s> (esc)\n' "$cmd" >&2; exit 130; }
        case "$a" in
            "")      a="$val" ;;
            "<clear>") a="" ;;
        esac
        printf '<%s> %s%s\n' "$cmd" "$a" "${val:+ (pre-filled: ${val})}" >&2
        printf '%s\n' "${a//\\n/$'\n'}" ;;
    style)
        # Drop flags and the values of the ones that take a value, so the
        # transcript carries the text and not the palette.
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --foreground|--background|--border|--border-foreground|--align|--width|--height|--margin|--padding)
                    shift 2 || shift ;;
                --*) shift ;;
                *)   printf '    %s\n' "$1" >&2; shift ;;
            esac
        done ;;
    log)  printf '[info] %s\n' "${*: -1}" >&2 ;;
    # Like gum, spin exits with the command's status: it used to exit 0
    # whatever the command did, so a failure a script must survive (a delete
    # that fails half way through a purge) could not be seen in a test.
    spin) while [[ $# -gt 0 && "$1" != "--" ]]; do shift; done; shift 2>/dev/null || true; "$@"; exit $? ;;
    # Commands gum has that no front-end here uses: a test that reaches one
    # must not pass on an empty answer the user could never have given.
    file|pager|table|format|join|version-check)
        printf '<stub-error> gum %s is not modelled by the stub\n' "$cmd" >&2
        [[ -n "${GUM_STUB_ERRLOG:-}" ]] && printf 'gum %s is not modelled by the stub\n' "$cmd" >> "$GUM_STUB_ERRLOG"
        exit 1 ;;
    *)
        # Like gum: an unknown command is a usage error, exit 80.
        printf 'gum: error: unexpected argument %s\n' "$cmd" >&2
        [[ -n "${GUM_STUB_ERRLOG:-}" ]] && printf 'gum %s: no such gum command\n' "$cmd" >> "$GUM_STUB_ERRLOG"
        exit 80 ;;
esac
exit 0
